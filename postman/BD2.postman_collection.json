{
  "info": {
    "name": "BD2 - Taller de bicicletas - Entrega 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con usuarios de npm run seed o npm run demo. Usar una base nueva para repetir la secuencia. Contiene pruebas positivas y negativas."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/api"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('futuro')) {",
          "  const now = Date.now();",
          "  pm.collectionVariables.set('futuro', new Date(now + 86400000).toISOString());",
          "  pm.collectionVariables.set('futuro2', new Date(now + 172800000).toISOString());",
          "  pm.collectionVariables.set('entregaEstimada', new Date(now + 604800000).toISOString());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Salud de la API",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/salud"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Rechazar acceso sin token",
